# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MAKE_API_KEY=your_make_api_key_here

# Gmail API (optional - only needed if using email extractor)
GMAIL_CREDENTIALS_PATH=./config/gmail_credentials.json

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Cache and Data
CACHE_DIR=./cache
DB_PATH=./cache/content_monitor.db

# Cost Management
DAILY_COST_LIMIT=5.0
MONTHLY_COST_LIMIT=100.0

# Performance Settings
MAX_WORKERS=5
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3

# Scheduling
ENABLE_SCHEDULER=true
CHECK_INTERVAL=3600

# Security
ENABLE_CONTENT_LOGGING=false
ANONYMIZE_DATA=true
